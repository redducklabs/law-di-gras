# Hosted demo: TLS (Let's Encrypt), static frontend, /api proxy, sign-in.
# Protected requests are checked by the backend (app/demo_auth.py): a valid
# session cookie passes; pages redirect to /login, API calls get 401.
# Provider share links (/p/*, /api/share/*), the static bundle and the sign-in
# routes stay public, the way a provider would open them in real use.
{$DEMO_DOMAIN} {
	encode zstd gzip

	@protected not path /p/* /api/share/* /assets/* /favicon.png /apple-touch-icon.png /brand/* /login /logout /api/auth/*
	forward_auth @protected api:8000 {
		uri /api/auth/check
	}

	handle /brand/* {
		root * /opt
		file_server
	}
	handle /login {
		rewrite * /api/auth/login
		reverse_proxy api:8000
	}
	handle /logout {
		rewrite * /api/auth/logout
		reverse_proxy api:8000
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
