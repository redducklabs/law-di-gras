# Hosted demo: TLS (Let's Encrypt), static frontend, /api proxy. Sign-in is the
# app's own (backend/app/auth: session cookie, Secure via X-Forwarded-Proto,
# which reverse_proxy sets). The SPA fallback serves /login, /cases,
# /matters/:id and /p/:token; /brand/* holds the logos used by /api/clio.
{$DEMO_DOMAIN} {
	encode zstd gzip

	handle /brand/* {
		root * /opt
		file_server
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
