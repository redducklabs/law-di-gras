# Copy to .env (gitignored) and fill in. Never commit real values.

# Clio Manage developer app (create at https://developers.clio.com, US region)
CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=
CLIO_REDIRECT_URI=http://127.0.0.1:8765/clio/callback
CLIO_BASE_URL=https://app.clio.com
# Filled in by our one-time OAuth login script; the app refreshes the access token.
CLIO_ACCESS_TOKEN=
CLIO_REFRESH_TOKEN=

# AI
ANTHROPIC_API_KEY=

# Retrieval embeddings (text-embedding-3-large)
OPENAI_API_KEY=
# Optional: Cohere rerank-v3.5. Without it, search uses RRF order.
COHERE_API_KEY=
